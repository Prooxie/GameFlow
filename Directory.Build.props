<Project>

  <!--
    Properties that apply to every project in the solution.
    Centralising these keeps the per-project .csproj files focused on
    dependencies and project-specific overrides only.
  -->
  <PropertyGroup>
    <!-- Target framework. .NET 10 is the LTS we ship on. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- The SDK's bundled runtime can lag servicing releases. Ship the patched runtime. -->
    <RuntimeFrameworkVersion>10.0.13</RuntimeFrameworkVersion>

    <!-- Modern C# defaults. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Build hygiene. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

    <!-- Reproducible builds: same inputs => same outputs. -->
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Publish has a different dependency graph for each RID. Keep its locks
         separate so publishing cannot rewrite the ordinary solution locks. -->
    <NuGetLockFilePath Condition="'$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifier).lock.json</NuGetLockFilePath>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!--
      Generate XML documentation files for every project. This both feeds
      Doxygen / DocFX downstream and surfaces "missing summary" hints in
      the IDE for new public APIs. CS1591 is downgraded so we don't drown
      in noise while doc coverage is still partial.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Common assembly metadata for every binary we ship. -->
    <Company>GameFlow contributors</Company>
    <Product>GameFlow</Product>
    <Copyright>Copyright (c) GameFlow contributors</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <Version Condition="'$(Version)' == ''">1.0.7</Version>
  </PropertyGroup>

  <!--
    Embed Source Link (when the file is present) so released builds can be
    debugged against the original git revision.
  -->
  <PropertyGroup Condition="'$(CI)' == 'true'">
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

</Project>
