<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GameFlow.App.ViewModels"
        xmlns:views="using:GameFlow.App.Views"
        x:Class="GameFlow.App.Views.SetupWalkthroughWindow"
        x:DataType="vm:SetupWalkthroughViewModel"
        x:CompileBindings="True"
        Title="{DynamicResource Ui.UiSetUpYourFirstController}"
        Width="900" Height="660"
        MinWidth="640" MinHeight="520"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppSurface0}">

  <!--
      Fixed size and CenterOwner on purpose: this is a linear, four-step
      task with one decision in it, and every step is authored to fit.
      A resizable wizard invites the user to hunt for content that is not
      off-screen.
  -->

  <Border Background="{DynamicResource AppSurface1}"
          BorderBrush="{DynamicResource AppBorder0}"
          BorderThickness="1">
    <DockPanel LastChildFill="True">

      <!-- Footer: step counter on the left, navigation on the right. -->
      <Border DockPanel.Dock="Bottom" Padding="24,14"
              Background="{DynamicResource AppSurface1}"
              BorderBrush="{DynamicResource AppBorder0}"
              BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
          <TextBlock Grid.Column="0" Text="{Binding StepNumberLabel}"
                     Classes="sectionLabel" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="ghost" Content="{DynamicResource Ui.UiBack}"
                  Command="{Binding BackCommand}" />
          <Button Grid.Column="3" Classes="primary" Padding="22,9"
                  Content="{Binding NextButtonLabel}"
                  Command="{Binding NextCommand}" />
        </Grid>
      </Border>

      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <Panel Margin="28,26">

          <!-- ═══ 1. What this app actually does ═══════════════════════
               The mental model is the thing to teach first. Everything
               else in the app assumes it, and nothing else explains it. -->
          <StackPanel Spacing="16" IsVisible="{Binding IsWelcomeStep}">
            <TextBlock Text="{DynamicResource Ui.UiWelcomeToGameFlow}" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource AppForeground}" />
            <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20"
                       Foreground="{DynamicResource AppForeground}"
                       Text="{DynamicResource Ui.UiGameFlowSitsBetweenYourControllerAndYourGameIt}" />

            <Border Classes="inset" Padding="16,14">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <TextBlock Grid.Column="0" Text="🎮" FontSize="18" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="{DynamicResource Ui.UiYourController}" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppForeground}" />
                    <TextBlock Classes="hint" Text="{DynamicResource Ui.UiThePhysicalPadKeyboardOrMouseYouHold}" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="↓" HorizontalAlignment="Center" FontSize="15"
                           Foreground="{DynamicResource AppAccent}" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <TextBlock Grid.Column="0" Text="⚙" FontSize="18" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="GameFlow" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppForeground}" />
                    <TextBlock Classes="hint" Text="{DynamicResource Ui.UiRemappingAutofireStickShapingMacros}" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="↓" HorizontalAlignment="Center" FontSize="15"
                           Foreground="{DynamicResource AppAccent}" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                  <TextBlock Grid.Column="0" Text="🕹" FontSize="18" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="{DynamicResource Ui.UiAVirtualController}" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppAccent}" />
                    <TextBlock Classes="hint" Text="{DynamicResource Ui.UiWhatTheGameSeesItLooksLikeRealHardware}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <TextBlock Classes="hint"
                       Text="{DynamicResource Ui.UiThisTakesAboutAMinuteAndLeavesYouWith}" />
          </StackPanel>

          <!-- ═══ 2. Find the pad ══════════════════════════════════════
               Live, so plugging in while this is open just works — and
               so it answers "does GameFlow see my controller at all?" -->
          <StackPanel Spacing="14" IsVisible="{Binding IsConnectStep}">
            <TextBlock Text="{DynamicResource Ui.SetupChooseInputs}" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource AppForeground}" />
            <TextBlock Classes="hint"
                       Text="{DynamicResource Ui.SetupChooseInputsHint}" />

            <!--
                Bounded height, with the list scrolling inside it. The
                controls that matter on this step — the status line and
                the "I have no controller" escape hatch — sit BELOW this
                box, so an unbounded list pushes them off the bottom of a
                fixed-size window and there is no way to reach them.
            -->
            <Border Classes="inset" Padding="12" Height="200">
              <Panel>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                            IsVisible="{Binding !DetectedDevices.Count}">
                  <TextBlock Text="🔌" FontSize="30" HorizontalAlignment="Center" Opacity="0.4" />
                  <TextBlock Classes="hint" TextAlignment="Center" MaxWidth="280"
                             Text="{DynamicResource Ui.UiWaitingForAController}" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <ListBox x:Name="InputDevicesList" ItemsSource="{Binding DetectedDevices}"
                         SelectionMode="Multiple,Toggle" SelectedItems="{Binding SelectedInputs, Mode=OneWay}"
                         Background="Transparent" BorderThickness="0" Padding="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:WalkthroughDevice">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="2,5">
                        <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{DynamicResource Semantic.Success}" />
                        <StackPanel Grid.Column="1" Spacing="1">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource AppForeground}" />
                          <TextBlock Classes="hint" Text="{Binding CategoryLabel}" />
                        </StackPanel>
                        <Border Grid.Column="2" Classes="chip" Padding="8,3"
                                IsVisible="{Binding IsGamepadLike}">
                          <TextBlock Text="{DynamicResource Ui.UiREADY}" FontSize="9" FontWeight="Bold"
                                     LetterSpacing="0.6"
                                     Foreground="{DynamicResource AppAccent}" />
                        </Border>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                </ScrollViewer>
              </Panel>
            </Border>

            <TextBlock Classes="hint" Text="{Binding DetectionMessage}" />


          </StackPanel>

          <!-- ═══ 3. Does the pad read correctly? ══════════════════════ -->
          <StackPanel Spacing="12" IsVisible="{Binding IsCheckLayoutStep}">
            <TextBlock Text="{DynamicResource Ui.UiCheckTheButtonsLineUp}" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource AppForeground}" />
            <TextBlock Classes="hint"
                       Text="{DynamicResource Ui.UiPressEachButtonOnYourControllerAndWatchIt}" />

            <!-- ControllerSurface declares MinHeight 260 and a fixed
                 30 px title row. A shorter box does not shrink it, it
                 clips it, and what goes first is the top of the title. -->
            <Border Classes="inset" Padding="10" Height="300">
              <views:ControllerSurface DataContext="{Binding PhysicalPreview}" />
            </Border>

            <!-- Calibration is the Devices page's own flow, driven from
                 here so the guide does not carry a second copy of it. -->
            <StackPanel Spacing="8" IsVisible="{Binding !Devices.IsAnyCalibrating}">
              <Button Content="{DynamicResource Ui.UiButtonsAreWrongCalibrateThem}"
                      Command="{Binding Devices.StartCalibrationCommand}"
                      HorizontalAlignment="Left" Padding="12,6" />
              <!-- Offered here and not only on the Devices page: a pad
                   whose stick lands on the wrong axis is exactly the pad
                   someone is setting up for the first time, and the
                   surface above shows it as a dead stick that pulls a
                   trigger. -->
              <Button Content="{DynamicResource Ui.UiSticksOrTriggersAreWrongCalibrateThem}"
                      Command="{Binding Devices.StartAxisCalibrationCommand}"
                      HorizontalAlignment="Left" Padding="12,6" />
            </StackPanel>

            <Border Classes="inset" Padding="12" IsVisible="{Binding Devices.IsAnyCalibrating}">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding Devices.CalibrationPrompt}" FontWeight="SemiBold"
                           Foreground="{DynamicResource AppForeground}" />
                <TextBlock Classes="hint" TextWrapping="Wrap"
                           Text="{Binding Devices.CalibrationHint}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="{DynamicResource Ui.UiSkipThisOne}" Command="{Binding Devices.SkipButtonCommand}" />
                  <Button Content="{DynamicResource Ui.UiSilence}" Command="{Binding Devices.SilenceAxisCommand}"
                          IsVisible="{Binding Devices.IsAxisCalibrating}" />
                  <Button Content="{DynamicResource Ui.MappingEditorCancelButton}" Command="{Binding Devices.CancelCalibrationCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ═══ 3b. Keyboard & mouse: which key does what ════════════ -->
          <StackPanel Spacing="12" IsVisible="{Binding IsKeyboardMouseStep}">
            <TextBlock Text="{DynamicResource Ui.UiYourKeyboardAndMouseAsAController}" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource AppForeground}" />
            <TextBlock Classes="hint" TextWrapping="Wrap"
                       Text="{DynamicResource Ui.UiEveryControllerButtonStickAndTriggerAndTheKeys}" />
            <Border Height="420">
              <views:KeyboardMouseMapView DataContext="{Binding KeyboardMouseEditor}" />
            </Border>
          </StackPanel>

          <!-- ═══ 4. The one decision ══════════════════════════════════ -->
          <StackPanel Spacing="14" IsVisible="{Binding IsOutputStep}">
            <TextBlock Text="{DynamicResource Ui.UiWhatShouldGamesSee}" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource AppForeground}" />
            <TextBlock Classes="hint"
                       Text="{DynamicResource Ui.UiGameFlowWillCreateThisControllerForYouItIs}" />

            <ListBox ItemsSource="{Binding OutputKinds}"
                     SelectedItem="{Binding SelectedOutputKind, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0" Padding="0">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="12,10" />
                  <Setter Property="Margin" Value="0,2" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:WalkthroughOutputKind">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                    <TextBlock Classes="hint" Text="{Binding Description}" MaxWidth="450" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Classes="hint"
                       Text="{DynamicResource Ui.UiNotPermanentYouCanChangeItLaterOrAdd}" />
          </StackPanel>

          <!-- ═══ 5. Name it ══════════════════════════════════════════ -->
          <StackPanel Spacing="14" IsVisible="{Binding IsNameStep}">
            <TextBlock Text="{DynamicResource Ui.UiGiveItAName}" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource AppForeground}" />
            <TextBlock Classes="hint"
                       Text="{DynamicResource Ui.UiThisIsWhatYouWillSeeInTheSidebar}" />

            <TextBox Text="{Binding SlotName, Mode=TwoWay}"
                     PlaceholderText="{DynamicResource Ui.UiLeaveEmptyToLetGameFlowNameIt}"
                     MaxLength="48" FontSize="14" Padding="10,8" />

            <TextBlock Classes="hint"
                       Text="{DynamicResource Ui.UiYouCanRenameItWheneverYouLikeOnThe}" />
          </StackPanel>

          <!-- ═══ 6. Both layouts, side by side ═══════════════════════ -->
          <StackPanel Spacing="12" IsVisible="{Binding IsReviewStep}">
            <TextBlock Text="{DynamicResource Ui.UiYouAreSetUp}" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource AppForeground}" />
            <TextBlock Classes="hint"
                       Text="{DynamicResource Ui.UiYourControllerOnTheLeftWhatGamesSeeOn}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel Grid.Column="0" Spacing="6">
                <TextBlock Text="{DynamicResource Ui.UiYourController}" Classes="sectionLabel" />
                <Border Classes="inset" Padding="8" Height="286">
                  <views:ControllerSurface DataContext="{Binding PhysicalPreview}" />
                </Border>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="{DynamicResource Ui.UiWhatGamesSee}" Classes="sectionLabel" />
                <Border Classes="inset" Padding="8" Height="286">
                  <views:ControllerSurface DataContext="{Binding VirtualPreview}" />
                </Border>
              </StackPanel>
            </Grid>

            <Border Classes="inset" Padding="16,14">
              <StackPanel Spacing="8">
                <TextBlock Text="✓" FontSize="20"
                           Foreground="{DynamicResource Semantic.Success}" />
                <TextBlock Text="{Binding SummaryMessage}" TextWrapping="Wrap"
                           FontSize="13" LineHeight="19"
                           Foreground="{DynamicResource AppForeground}" />
              </StackPanel>
            </Border>

            <StackPanel Spacing="8">
              <TextBlock Text="{DynamicResource Ui.UiWhereToGoNext}" Classes="sectionLabel" />
              <TextBlock Classes="hint"
                         Text="{DynamicResource Ui.UiDashboardYourPadAndTheVirtualOneSideBy}" />
              <TextBlock Classes="hint"
                         Text="{DynamicResource Ui.UiProfilesRemappingAutofireStickShapingAndMacros}" />
              <TextBlock Classes="hint"
                         Text="{DynamicResource Ui.UiDevicesAssignMoreControllersAndTuneSticksTriggersRumble}" />
            </StackPanel>
          </StackPanel>

        </Panel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
