<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GameFlow.App.ViewModels"
             x:Class="GameFlow.App.Views.KeyboardMouseMapView"
             x:DataType="vm:KeyboardMouseMapEditorViewModel"
             x:CompileBindings="True">

  <!--
      The complete controller map for a keyboard and a mouse: every control
      a pad has, each with the keys and mouse inputs that produce it, plus
      what mouse movement drives. Used by its own window, by the setup guide
      for a keyboard-and-mouse setup, and reachable from the Devices page.
  -->
  <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12">
      <TextBlock Text="{DynamicResource Ui.InputMapDevice}" VerticalAlignment="Center" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>

    <!-- Mouse movement -->
    <Border Grid.Row="1" IsVisible="{Binding ShowMouseOptions}" Classes="inset" Padding="12,10">
      <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Ui.UiMouseMovement}" VerticalAlignment="Center" FontSize="12" />
        <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding MotionTargets}"
                  SelectedItem="{Binding SelectedMotionTarget, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <CheckBox Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Content="{DynamicResource Ui.UiInvertVertical}"
                  IsChecked="{Binding InvertMouseY, Mode=TwoWay}" VerticalAlignment="Center" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Ui.TouchpadStickSensitivity}" VerticalAlignment="Center" FontSize="12" />
        <Slider Grid.Row="1" Grid.Column="1" Classes="row" Minimum="0.1" Maximum="5" SmallChange="0.05"
                Value="{Binding MouseSensitivity, Mode=TwoWay}"
                ToolTip.Tip="{DynamicResource Ui.UiHowFarTheStickMovesForAGivenMouse}" />
        <TextBlock Grid.Row="1" Grid.Column="2" Text="{DynamicResource Ui.UiAntiDeadzone}" VerticalAlignment="Center" FontSize="12" />
        <Slider Grid.Row="1" Grid.Column="3" Classes="row" Minimum="0" Maximum="0.5" SmallChange="0.01"
                Value="{Binding MouseAntiDeadzone, Mode=TwoWay}"
                ToolTip.Tip="{DynamicResource Ui.UiTheSmallestStickPushAMovingMouseProducesRaise}" />
      </Grid>
    </Border>

    <!-- Capture banner. Clicks and wheel notches inside it are what get
         bound, so operating the editor with the mouse never binds by
         accident. -->
    <Border Grid.Row="2" x:Name="CaptureBox" IsVisible="{Binding IsCapturing}"
            Background="{DynamicResource AppAccentSoft}"
            BorderBrush="{DynamicResource AppAccent}" BorderThickness="2"
            CornerRadius="8" Padding="14,16" MinHeight="64"
            Cursor="Hand"
            PointerPressed="OnCapturePointerPressed"
            PointerWheelChanged="OnCaptureWheel">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="{Binding CapturePrompt}" TextWrapping="Wrap" FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="ghost" Content="{DynamicResource Ui.MappingEditorCancelButton}" Command="{Binding CancelCaptureCommand}" />
      </Grid>
    </Border>

    <!-- Every control, its bindings, and bind / clear -->
    <Border Grid.Row="3" Classes="card" Padding="6">
      <Grid RowDefinitions="*,Auto">
        <ScrollViewer VerticalScrollBarVisibility="Auto" AllowAutoHide="False">
          <ItemsControl ItemsSource="{Binding Rows}" Margin="4,0,12,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:KeyboardMouseActionRow">
                <Grid ColumnDefinitions="180,*,Auto,Auto" ColumnSpacing="8" Margin="0,3">
                  <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" FontSize="12"
                             FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <Panel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Ui.UiNotBound}" Classes="hint" IsVisible="{Binding !HasBindings}" />
                    <ItemsControl ItemsSource="{Binding Bindings}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:KeyboardMouseBindingChip">
                          <Border Classes="chip" Padding="6,2" Margin="0,1,6,1">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <TextBlock Text="{Binding Icon}" FontSize="10" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center" />
                              <Button Classes="iconOnly" Content="✕" FontSize="9" Padding="3,0"
                                      ToolTip.Tip="{DynamicResource Ui.UiRemoveThisBinding}"
                                      Command="{Binding RemoveCommand}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Panel>
                  <Button Grid.Column="2" Classes="ghost" Padding="10,4" FontSize="11"
                          Content="{Binding AddLabel}" Command="{Binding AddCommand}" />
                  <Button Grid.Column="3" Classes="ghost" Padding="8,4" FontSize="11"
                          Content="{DynamicResource Ui.UiClear}" Command="{Binding ClearCommand}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="4,8,4,2">
          <TextBlock Classes="hint" TextWrapping="Wrap" VerticalAlignment="Center"
                     Text="{DynamicResource Ui.UiChangesSaveImmediatelyAndApplyToEveryKeyboardAnd}" />
          <Button Grid.Column="1" Classes="ghost" Content="{DynamicResource Ui.ResetProfileButton}" Command="{Binding ResetToDefaultCommand}" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
