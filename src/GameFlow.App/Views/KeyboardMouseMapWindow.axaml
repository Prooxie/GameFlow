<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GameFlow.App.ViewModels"
        xmlns:views="using:GameFlow.App.Views"
        x:Class="GameFlow.App.Views.KeyboardMouseMapWindow"
        x:DataType="vm:KeyboardMouseMapEditorViewModel"
        x:CompileBindings="True"
        Title="{DynamicResource Ui.UiKeyboardMouseControls}"
        Width="760" Height="720"
        MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppSurface0}">
  <Border Background="{DynamicResource AppSurface1}"
          BorderBrush="{DynamicResource AppBorder0}" BorderThickness="1">
    <DockPanel LastChildFill="True">
      <Border DockPanel.Dock="Bottom" Padding="20,12"
              BorderBrush="{DynamicResource AppBorder0}" BorderThickness="0,1,0,0">
        <Button Classes="primary" HorizontalAlignment="Right" Padding="22,9"
                Content="{DynamicResource Ui.UiDone}" IsCancel="True" IsDefault="True" Click="OnCloseClick" />
      </Border>
      <StackPanel DockPanel.Dock="Top" Margin="20,16,20,0" Spacing="4">
        <TextBlock Text="{DynamicResource Ui.UiKeyboardMouseControls}" FontSize="18" FontWeight="Bold" />
        <TextBlock Classes="hint" TextWrapping="Wrap"
                   Text="{DynamicResource Ui.UiWhatEachKeyAndMouseInputDoesOnThe}" />
      </StackPanel>
      <views:KeyboardMouseMapView Margin="20,12,20,16" />
    </DockPanel>
  </Border>
</Window>
