<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GameFlow.App.ViewModels"
        xmlns:views="using:GameFlow.App.Views"
        x:Class="GameFlow.App.Views.PhoneControllerWindow"
        x:DataType="vm:PhoneSheetViewModel"
        x:CompileBindings="True"
        Title="{Binding Title}"
        Width="640" Height="600"
        MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppSurface0}">

  <!--
      One phone's sheet: its name, a QR code of its own link, and whether it
      has connected. Opened from Devices > Physical devices > Add phone, and
      from a phone's own row there.

      The QR code is the point. A phone's link carries a 64-character
      access token, so the old sheet's "type this address into the phone"
      was not a realistic instruction; pointing a camera at the screen is.
  -->
  <Border Background="{DynamicResource AppSurface1}"
          BorderBrush="{DynamicResource AppBorder0}" BorderThickness="1">
    <DockPanel LastChildFill="True">

      <Border DockPanel.Dock="Bottom" Padding="20,12"
              BorderBrush="{DynamicResource AppBorder0}" BorderThickness="0,1,0,0">
        <Button Classes="primary" HorizontalAlignment="Right" Padding="22,9"
                Content="{DynamicResource Ui.UiDone}" IsCancel="True" IsDefault="True" Click="OnCloseClick" />
      </Border>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,20" ColumnDefinitions="Auto,*" ColumnSpacing="22" RowDefinitions="Auto,Auto">

          <!-- QR code, or why there is none yet -->
          <Border Grid.Column="0" Grid.Row="0" Width="248" Height="248"
                  CornerRadius="10" Background="White" ClipToBounds="True"
                  VerticalAlignment="Top">
            <Panel>
              <views:QrCodeView Code="{Binding Code}" IsVisible="{Binding HasLink}" Margin="4" />
              <TextBlock IsVisible="{Binding !HasLink}" Text="{DynamicResource Ui.UiNoCodeWhilePhoneSharingIsOff}"
                         Foreground="#55606E" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" />
            </Panel>
          </Border>

          <StackPanel Grid.Column="1" Grid.Row="0" Spacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="{DynamicResource Ui.UiNAME}" Classes="sectionLabel" />
              <TextBox Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" MaxLength="40" />
            </StackPanel>

            <Border Classes="inset" Padding="10,8">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Panel Width="10" Height="10" VerticalAlignment="Top" Margin="0,4,0,0">
                  <Ellipse Width="10" Height="10" Fill="{DynamicResource AppSuccess}" IsVisible="{Binding IsConnected}" />
                  <Ellipse Width="10" Height="10" Fill="{DynamicResource AppWarning}" IsVisible="{Binding !IsConnected}" />
                </Panel>
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource AppForeground}" />
              </Grid>
            </Border>

            <StackPanel Spacing="6" IsVisible="{Binding !HasLink}">
              <TextBlock Classes="hint" TextWrapping="Wrap"
                         Text="{DynamicResource Ui.UiPhonesReachGameFlowOverYourNetworkSharingIsOff}" />
              <Button Classes="primary" HorizontalAlignment="Left"
                      Content="{Binding Network.NetworkSharingButtonLabel}"
                      Command="{Binding Network.ToggleNetworkSharingCommand}" />
              <TextBlock Classes="hint" Text="{Binding Network.NetworkSharingStatus}" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding HasLink}">
              <TextBlock Text="{DynamicResource Ui.UiLINK}" Classes="sectionLabel" />
              <!-- No "open in this PC's browser" button: the link claims this
                   phone's seat, so opening it here would move the phone to
                   the PC and disconnect the real one. -->
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox Grid.Column="0" IsReadOnly="True" FontSize="11" Text="{Binding Link, Mode=OneWay}"
                         TextWrapping="NoWrap" />
                <Button Grid.Column="1" Classes="ghost" Content="{DynamicResource Ui.UiCopy}" Click="OnCopyClick" />
              </Grid>
              <TextBlock Classes="hint" TextWrapping="Wrap"
                         Text="{DynamicResource Ui.UiThisLinkIsThisPhoneSAloneOpeningIt}" />
            </StackPanel>
          </StackPanel>

          <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="10" Margin="0,18,0,0">
            <Border Classes="inset" Padding="10,8"
                    IsVisible="{Binding Network.HasReachabilityWarning}"
                    Background="{DynamicResource AppWarningSoft}"
                    BorderBrush="{DynamicResource AppWarning}">
              <StackPanel Spacing="8">
                <TextBlock Classes="hint" Foreground="{DynamicResource AppForeground}"
                           Text="{Binding Network.ReachabilityMessage}" TextWrapping="Wrap" />
                <Button Classes="ghost" HorizontalAlignment="Right" Content="{DynamicResource Ui.UiAllowThroughFirewall}"
                        ToolTip.Tip="{DynamicResource Ui.UiAddsAnInboundRuleForGameFlowOnThisPort}"
                        IsVisible="{Binding Network.CanAllowThroughFirewall}"
                        Command="{Binding Network.AllowThroughFirewallCommand}" />
              </StackPanel>
            </Border>

            <Border Classes="divider" />
            <TextBlock Text="{DynamicResource Ui.UiONTHEPHONE}" Classes="sectionLabel" />
            <TextBlock Classes="hint" TextWrapping="Wrap"
                       Text="{DynamicResource Ui.UiHoldItSidewaysAndTapToStartItGoes}" />
            <TextBlock Classes="hint" TextWrapping="Wrap"
                       Text="{DynamicResource Ui.UiUpTo16PhonesAtOnceEachItsOwn}" />
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </DockPanel>
  </Border>
</Window>
