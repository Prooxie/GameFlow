<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GameFlow.App.Views.ConfirmDialog"
        Width="420" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppSurface0}">
  <!--
      A yes/no question before something that cannot be undone. Used where
      an inline flyout used to ask: a flyout's buttons did not reliably
      reach the row that opened them, so "Delete" and "Remove" did nothing.
  -->
  <Border Background="{DynamicResource AppSurface1}"
          BorderBrush="{DynamicResource AppBorder0}" BorderThickness="1">
    <StackPanel Margin="22,20" Spacing="16">
      <TextBlock x:Name="HeadingText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                 Foreground="{DynamicResource AppForeground}" />
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="12.5"
                 Foreground="{DynamicResource AppForegroundDim}" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Classes="ghost" Content="{DynamicResource Ui.MappingEditorCancelButton}" IsCancel="True" Click="OnCancelClick" Padding="16,7" />
        <Button x:Name="ConfirmButton" Classes="danger" IsDefault="True" Click="OnConfirmClick" Padding="16,7" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
