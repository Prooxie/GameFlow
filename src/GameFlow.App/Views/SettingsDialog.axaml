<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GameFlow.App.ViewModels"
        x:Class="GameFlow.App.Views.SettingsDialog"
        x:DataType="vm:SettingsDialogViewModel"
        Width="780"
        Height="680"
        MinWidth="680"
        MinHeight="380"
        MaxHeight="900"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppSurface0}"
        Title="{Binding TitleLabel}">

  <!--
      One page style for every tab.

      The scroll bar appears only when a page is taller than the window:
      most tabs fit, and a permanent empty bar beside them read as "there is
      more below" when there was not. AllowAutoHide stays False, so when a
      bar is needed it is a solid one that announces content below the
      fold rather than an overlay that only appears on hover.

      Padding lives on the CONTENT (settingsPage StackPanel), not on the
      ScrollViewer. A ScrollViewer's own Padding insets the viewport, but the
      bottom inset is not added to the scrollable extent, so the last 20px
      of the form could never be scrolled into view. Putting the inset on the
      StackPanel makes it part of the measured content.
  -->
  <Window.Styles>
    <Style Selector="ScrollViewer.settingsPage">
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="AllowAutoHide" Value="False" />
    </Style>
    <Style Selector="StackPanel.settingsPage">
      <Setter Property="Spacing" Value="20" />
      <Setter Property="Margin" Value="24,20" />
    </Style>
  </Window.Styles>

  <Border Background="{DynamicResource AppSurface1}"
          BorderBrush="{DynamicResource AppBorder0}"
          BorderThickness="1">

    <DockPanel LastChildFill="True">

      <!-- Footer. Outside the tabs on purpose: Apply, Cancel and Restore
           defaults act on every tab at once. One row: the status message
           takes the space left of the buttons instead of a row of its own,
           which sat empty almost all of the time. -->
      <Border DockPanel.Dock="Bottom"
              Padding="16,10"
              Background="{DynamicResource AppSurface1}"
              BorderBrush="{DynamicResource AppBorder0}"
              BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">

          <TextBlock Grid.Column="0"
                     Text="{Binding StatusMessage}"
                     FontSize="12"
                     Foreground="{DynamicResource AppForeground}"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap" MaxLines="2"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding StatusMessage}" />

          <Button Grid.Column="1" Classes="ghost"
                  Content="{Binding RestoreDefaultsButtonLabel}"
                  Command="{Binding RestoreDefaultsCommand}" />

          <Button Grid.Column="2" Classes="ghost"
                  Content="{Binding CancelButtonLabel}"
                  IsCancel="True"
                  Click="OnCancelClick" />

          <Button Grid.Column="3" Classes="primary"
                  Content="{Binding ApplyButtonLabel}"
                  IsDefault="True"
                  Click="OnApplyClick"
                  Padding="18,7" />

        </Grid>
      </Border>


      <!--
          Sections grouped into tabs by what the user came to change, rather
          than one page holding everything: the common things (language,
          theme, window, startup) first, the rarely touched ones (log level,
          folder overrides) last under Advanced.

          Tabs down the LEFT rather than across the top: five headers, two of
          them long ("Input & performance", "Network & phones"), do not fit
          side by side at this dialog's width in every language, and a top
          strip that wraps onto a second row stops reading as one set of
          tabs. A vertical list also has room to grow.

          SelectedIndex is remembered for the session by the view-model, so
          reopening Options lands on the page the user was last working in.
          The ORDER of the TabItems below is therefore part of that contract
          — see the tab index constants on SettingsDialogViewModel.
      -->
      <TabControl Name="SettingsTabs"
                  TabStripPlacement="Left"
                  SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
        <TabControl.ItemsPanel>
          <!-- A StackPanel rather than the theme's WrapPanel, so every
               header stretches to the widest one and the selected
               background reads as one even column, not a ragged edge. -->
          <ItemsPanelTemplate>
            <StackPanel Orientation="Vertical" Spacing="2" />
          </ItemsPanelTemplate>
        </TabControl.ItemsPanel>
        <TabControl.Styles>
          <Style Selector="TabControl#SettingsTabs /template/ ItemsPresenter">
            <Setter Property="Margin" Value="12,16,12,16" />
            <Setter Property="MinWidth" Value="150" />
          </Style>
          <!-- The divider between the tab list and the page. -->
          <Style Selector="TabControl#SettingsTabs /template/ ContentPresenter#PART_SelectedContentHost">
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder0}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
          </Style>
          <!-- The app-wide TabItem style is shaped for a top strip (right
               gutter, top-only rounded corners); a vertical list wants a
               fully rounded row, with the gap between rows coming from the
               panel's Spacing instead of a margin. -->
          <Style Selector="TabControl#SettingsTabs > TabItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
          </Style>
          <Style Selector="TabControl#SettingsTabs > TabItem /template/ Border#LayoutRoot">
            <Setter Property="CornerRadius" Value="8" />
          </Style>
        </TabControl.Styles>

        <!-- ═══ GENERAL ═══════════════════════════════════════════════ -->
        <TabItem Header="{Binding GeneralTabHeader}">
          <ScrollViewer Classes="settingsPage">
            <StackPanel Classes="settingsPage">

              <!-- Localization & Appearance section -->
              <StackPanel Spacing="10">
                <TextBlock Text="{DynamicResource Ui.UiLocalizationAppearance}"
                           Classes="sectionHeading" />
                <TextBlock Classes="hint" TextWrapping="Wrap" Text="{DynamicResource Ui.UiLanguageAndThemeChangesSaveImmediatelyCancelDoesNot}" />
                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                  <TextBlock Grid.Row="0" Grid.Column="0"
                             Text="{Binding Shell.LanguageLabel}"
                             FontSize="12" Foreground="{DynamicResource AppForeground}"
                             VerticalAlignment="Center" />
                  <ComboBox Grid.Row="0" Grid.Column="1"
                            Width="240" HorizontalAlignment="Left"
                            AutomationProperties.Name="{Binding Shell.LanguageLabel}"
                            ItemsSource="{Binding Shell.SupportedLanguages}"
                            SelectedItem="{Binding Shell.SelectedLanguage}" />
                  <TextBlock Grid.Row="1" Grid.Column="0"
                             Text="{Binding Shell.ThemeLabel}"
                             FontSize="12" Foreground="{DynamicResource AppForeground}"
                             VerticalAlignment="Center" />
                  <ComboBox Grid.Row="1" Grid.Column="1"
                            Width="240" HorizontalAlignment="Left"
                            AutomationProperties.Name="{Binding Shell.ThemeLabel}"
                            ItemsSource="{Binding Shell.ThemeOptions}"
                            SelectedItem="{Binding Shell.SelectedTheme}" />
                </Grid>
              </StackPanel>

              <Border Classes="divider" />

              <!-- Window section -->
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding WindowHeaderLabel}" Classes="sectionHeading" />
                <CheckBox Content="{Binding RememberWindowSizeLabel}" IsChecked="{Binding RememberWindowSize, Mode=TwoWay}" />
                <Grid ColumnDefinitions="180,Auto,Auto,Auto" ColumnSpacing="8" IsEnabled="{Binding RememberWindowSize}">
                  <TextBlock Text="{Binding WindowWidthLabel}" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="1" Width="100" Minimum="200" Maximum="8000" Increment="50"
                                 AutomationProperties.Name="{Binding WindowWidthLabel}"
                                 Value="{Binding WindowWidth, Mode=TwoWay}" />
                  <TextBlock Grid.Column="2" Text="{Binding WindowHeightLabel}" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="3" Width="100" Minimum="200" Maximum="8000" Increment="50"
                                 AutomationProperties.Name="{Binding WindowHeightLabel}"
                                 Value="{Binding WindowHeight, Mode=TwoWay}" />
                </Grid>
              </StackPanel>

              <Border Classes="divider" />

              <!-- Startup section -->
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding StartupHeaderLabel}"
                           Classes="sectionHeading" />
                <CheckBox IsChecked="{Binding CheckForUpdatesOnStartup, Mode=TwoWay}"
                          Content="{Binding CheckUpdatesLabel}"
                          Foreground="{DynamicResource AppForeground}" />
                <CheckBox IsChecked="{Binding CheckRequirementsOnStartup, Mode=TwoWay}"
                          Content="{Binding CheckRequirementsLabel}"
                          Foreground="{DynamicResource AppForeground}" />
              </StackPanel>

              <Border Classes="divider" />

              <!-- Setup walkthrough. The sidebar's "Setup guide" opens the
                   same thing; it is offered here as well because Options is
                   where people go looking for "how do I set this up again",
                   and the first-run showing is once-only. -->
              <StackPanel Spacing="6">
                <TextBlock Text="{DynamicResource Ui.UiSetup}" Classes="sectionHeading" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBlock Grid.Column="0" Classes="hint" VerticalAlignment="Center" TextWrapping="Wrap"
                             Text="{DynamicResource Ui.UiWalksThroughConnectingAControllerAndCreatingAVirtual}" />
                  <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Center"
                          Content="{DynamicResource Ui.UiRunSetupWalkthrough}"
                          Click="OnRunWalkthrough" />
                </Grid>
              </StackPanel>

            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ═══ INPUT & PERFORMANCE ═══════════════════════════════════ -->
        <TabItem Header="{Binding InputPerformanceTabHeader}">
          <ScrollViewer Classes="settingsPage">
            <StackPanel Classes="settingsPage">

              <!-- Polling section -->
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding PollingHeaderLabel}" Classes="sectionHeading" />
                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                  <TextBlock Text="{Binding DashboardRefreshLabel}" Foreground="{DynamicResource AppForeground}" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Width="160" HorizontalAlignment="Left" PlaceholderText="{DynamicResource Ui.UiAutomatic}"
                           AutomationProperties.Name="{Binding DashboardRefreshLabel}"
                           Text="{Binding DashboardRefreshHzText, Mode=TwoWay}" />
                  <TextBlock Grid.Row="1" Text="{Binding PollingRateLabel}" Foreground="{DynamicResource AppForeground}" VerticalAlignment="Center" />
                  <TextBox Grid.Row="1" Grid.Column="1" Width="160" HorizontalAlignment="Left" PlaceholderText="{DynamicResource Ui.UiUseProfileRate}"
                           AutomationProperties.Name="{Binding PollingRateLabel}"
                           Text="{Binding PollingRateHzText, Mode=TwoWay}" />
                </Grid>
                <TextBlock Text="{Binding PollingHintLabel}" Classes="hint" TextWrapping="Wrap" />
              </StackPanel>

            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ═══ PROFILES ══════════════════════════════════════════════ -->
        <TabItem Header="{Binding ProfilesTabHeader}">
          <ScrollViewer Classes="settingsPage">
            <StackPanel Classes="settingsPage">

              <!-- Per-app profile switching. The "in front now" line and the
                   Use button exist because a rule matches an EXECUTABLE name,
                   which nobody can guess from a game's title — without them
                   the first rule anyone writes silently never fires. -->
              <StackPanel Spacing="6">
                <TextBlock Text="{DynamicResource Ui.UiPerAppProfiles}" Classes="sectionHeading" />
                <TextBlock Classes="hint" TextWrapping="Wrap"
                           Text="{DynamicResource Ui.UiApplicationSwitchingRulesSaveImmediatelyCancelDoesNotUndo}" />
                <CheckBox IsChecked="{Binding AppProfiles.IsEnabled, Mode=TwoWay}"
                          Content="{DynamicResource Ui.UiSwitchProfileAutomaticallyWhenAnAppComesToThe}"
                          Foreground="{DynamicResource AppForeground}" />
                <TextBlock Classes="hint" TextWrapping="Wrap"
                           Text="{Binding AppProfiles.Status}" />

                <ItemsControl ItemsSource="{Binding AppProfiles.Rules}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AppProfileRuleViewModel">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,2">
                        <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                  AutomationProperties.Name="{Binding ProcessName}" />
                        <TextBlock Grid.Column="1" Text="{Binding ProcessName}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppForeground}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding ProfileName}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppForegroundDim}"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="3" Classes="ghost" Content="{DynamicResource Ui.TouchpadRemove}"
                                Command="{Binding $parent[ItemsControl].((vm:AppProfilePanelViewModel)DataContext).RemoveRuleCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid ColumnDefinitions="*,Auto,160,Auto" ColumnSpacing="8">
                  <TextBox Grid.Column="0" PlaceholderText="{DynamicResource Ui.UiExecutableName}"
                           AutomationProperties.Name="Executable name"
                           Text="{Binding AppProfiles.NewProcessName, Mode=TwoWay}" />
                  <Button Grid.Column="1" Classes="ghost" Content="{DynamicResource Ui.UiUseCurrent}"
                          Command="{Binding AppProfiles.UseCurrentAppCommand}" />
                  <ComboBox Grid.Column="2" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Profile"
                            ItemsSource="{Binding AppProfiles.Profiles}"
                            SelectedItem="{Binding AppProfiles.NewProfile, Mode=TwoWay}"
                            DisplayMemberBinding="{Binding Label}" />
                  <Button Grid.Column="3" Content="{DynamicResource Ui.UiAdd}"
                          Command="{Binding AppProfiles.AddRuleCommand}" />
                </Grid>
                <TextBlock Classes="hint" TextWrapping="Wrap"
                           Text="{DynamicResource Ui.UiRulesAreCheckedTopToBottomAndTheFirst}" />
              </StackPanel>

            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ═══ NETWORK & PHONES ══════════════════════════════════════ -->
        <TabItem Header="{Binding NetworkTabHeader}">
          <ScrollViewer Classes="settingsPage">
            <StackPanel Classes="settingsPage">

              <!-- Phone controllers: the NETWORK side only. Phones themselves
                   are added one at a time from Devices → Physical devices,
                   where each gets its own link and QR code next to the device
                   it becomes — so there is no single address to show here any
                   more. What stays is what applies to every phone at once:
                   whether the server listens on the network at all, the
                   private-link reset, and whether Windows lets phones in. -->
              <StackPanel Spacing="6">
                <TextBlock Text="{DynamicResource Ui.UiPhoneControllers}" Classes="sectionHeading" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="{Binding Overlay.NetworkSharingButtonLabel}"
                          Command="{Binding Overlay.ToggleNetworkSharingCommand}"
                          HorizontalAlignment="Left" />
                  <Button Classes="ghost" Content="{DynamicResource Ui.UiResetPrivateLink}"
                          Command="{Binding Overlay.ResetPrivateLinkCommand}"
                          ToolTip.Tip="{DynamicResource Ui.UiDisconnectsEveryPhoneAndInvalidatesTheirLinksReconnectEach}"
                          HorizontalAlignment="Left" />
                </StackPanel>
                <TextBlock Classes="hint" Text="{Binding Overlay.NetworkSharingStatus}" TextWrapping="Wrap" />
                <TextBlock Classes="hint" TextWrapping="Wrap"
                           Text="{DynamicResource Ui.UiSharingIsSavedImmediatelyKeepPhoneLinksPrivateUse}" />
                <TextBlock Classes="hint" TextWrapping="Wrap"
                           Text="{DynamicResource Ui.UiAddPhonesFromDevicesPhysicalDevicesAddPhoneEach}" />
                <!--
                    Reachability line. A phone's link can be perfectly
                    correct and still time out, because Windows Firewall
                    drops the inbound connection silently. Saying so here,
                    next to the sharing switch, is the difference between a
                    one-click fix and an unexplained failure.

                    One button for every case: no rule, an old rule that does
                    not match, or no URL reservation. An elevated GameFlow
                    writes the rule by itself when the server starts, so this
                    button is for a GameFlow that is not elevated.
                -->
                <Border Classes="inset" Padding="10,8"
                        IsVisible="{Binding Overlay.HasReachabilityWarning}"
                        Background="{DynamicResource AppWarningSoft}"
                        BorderBrush="{DynamicResource AppWarning}">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="hint"
                               Foreground="{DynamicResource AppForeground}"
                               Text="{Binding Overlay.ReachabilityMessage}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                      <Button Classes="ghost"
                              Content="{DynamicResource Ui.UiAllowThroughFirewall}"
                              ToolTip.Tip="{DynamicResource Ui.UiAddsAnInboundRuleForGameFlowOnThisPort}"
                              IsVisible="{Binding Overlay.CanAllowThroughFirewall}"
                              Command="{Binding Overlay.AllowThroughFirewallCommand}" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <TextBlock Classes="hint" TextWrapping="Wrap"
                           Text="{DynamicResource Ui.UiTheBrowserReconnectsAutomaticallyAndKeepsTheSamePad}" />
              </StackPanel>

              <Border Classes="divider" />

              <!-- Motion server (DSU / Cemuhook). A single global switch, not a
                   per-controller one: the server streams whichever slots are
                   enabled, and emulators address pads by DSU slot index, so
                   there is nothing meaningful to turn on for one controller and
                   off for another. Saves immediately rather than on Apply,
                   matching the toggle's own behaviour. -->
              <StackPanel Spacing="6">
                <TextBlock Text="{DynamicResource Ui.UiMotionServer}" Classes="sectionHeading" />
                <TextBlock Classes="hint" Text="{DynamicResource Ui.UiTheseControlsSaveImmediatelyCancelDoesNotUndoThem}" TextWrapping="Wrap" />
                <CheckBox IsChecked="{Binding MotionServer.AllowRemote, Mode=TwoWay}" Content="{DynamicResource Ui.UiAllowEmulatorsOnOtherDevicesTrustedNetworkOnly}" />
                <CheckBox IsChecked="{Binding MotionServer.IsEnabled, Mode=TwoWay}"
                          Content="{DynamicResource Ui.UiEnableDSUCemuhookMotionServer}"
                          Foreground="{DynamicResource AppForeground}" />
                <TextBlock Classes="hint" TextWrapping="Wrap"
                           Text="{DynamicResource Ui.UiStreamsGyroscopeAndAccelerometerOverUDPSoCemuDolphin}" />
                <Grid ColumnDefinitions="180,Auto" VerticalAlignment="Center">
                  <TextBlock Grid.Column="0" Text="{DynamicResource Ui.UiUDPPort}"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource AppForeground}" />
                  <TextBox Grid.Column="1" Width="100"
                           AutomationProperties.Name="UDP port"
                           Text="{Binding MotionServer.Port, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                </Grid>
                <TextBlock Classes="hint"
                           Text="{DynamicResource Ui.UiPortMustBeBetween1024And65535}"
                           IsVisible="{Binding MotionServer.HasPortError}"
                           Foreground="{DynamicResource AppDanger}" />
                <TextBlock Classes="hint" TextWrapping="Wrap"
                           Text="{Binding MotionServer.Status}" />
              </StackPanel>

            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ═══ ADVANCED ══════════════════════════════════════════════ -->
        <TabItem Header="{Binding AdvancedTabHeader}">
          <ScrollViewer Classes="settingsPage">
            <StackPanel Classes="settingsPage">

              <!-- Diagnostics section -->
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding DiagnosticsHeaderLabel}"
                           Classes="sectionHeading" />
                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto" RowSpacing="6">
                  <TextBlock Grid.Column="0" Text="{Binding LogLevelLabel}"
                             FontSize="12" Foreground="{DynamicResource AppForeground}"
                             VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1"
                            Width="200"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="{Binding LogLevelLabel}"
                            ItemsSource="{Binding AvailableLogLevels}"
                            SelectedItem="{Binding SelectedLogLevel, Mode=TwoWay}" />
                </Grid>
                <TextBlock Text="{Binding LogLevelHintLabel}"
                           Classes="hint" TextWrapping="Wrap" />
              </StackPanel>

              <Border Classes="divider" />

              <!-- Paths section -->
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding PathsHeaderLabel}"
                           Classes="sectionHeading" />

                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding ProfilesDirectoryLabel}"
                             FontSize="12" Foreground="{DynamicResource AppForeground}" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox Grid.Column="0"
                             AutomationProperties.Name="{Binding ProfilesDirectoryLabel}"
                             Text="{Binding ProfilesDirectoryOverride, Mode=TwoWay}"
                             PlaceholderText="{Binding CurrentProfilesPath}" />
                    <Button Grid.Column="1" Classes="ghost"
                            Content="{Binding BrowseButtonLabel}"
                            Tag="profiles"
                            Click="OnBrowseClick"
                            Padding="14,8" />
                  </Grid>
                  <TextBlock Text="{Binding CurrentProfilesPath}"
                             FontSize="10.5" Foreground="{DynamicResource AppForegroundDim}"
                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding LogsDirectoryLabel}"
                             FontSize="12" Foreground="{DynamicResource AppForeground}" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox Grid.Column="0"
                             AutomationProperties.Name="{Binding LogsDirectoryLabel}"
                             Text="{Binding LogsDirectoryOverride, Mode=TwoWay}"
                             PlaceholderText="{Binding CurrentLogsPath}" />
                    <Button Grid.Column="1" Classes="ghost"
                            Content="{Binding BrowseButtonLabel}"
                            Tag="logs"
                            Click="OnBrowseClick"
                            Padding="14,8" />
                  </Grid>
                  <TextBlock Text="{Binding CurrentLogsPath}"
                             FontSize="10.5" Foreground="{DynamicResource AppForegroundDim}"
                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding LogsPathHintLabel}"
                             Classes="hint" TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>

            </StackPanel>
          </ScrollViewer>
        </TabItem>

      </TabControl>

    </DockPanel>
  </Border>
</Window>
