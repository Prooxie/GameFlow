<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GameFlow.App.ViewModels"
        x:Class="GameFlow.App.Views.SettingsDialog"
        x:DataType="vm:SettingsDialogViewModel"
        Width="640"
        Height="760"
        MinWidth="540"
        MinHeight="380"
        MaxHeight="900"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppSurface0}"
        Title="{Binding TitleLabel}">

  <Border Background="{DynamicResource AppSurface1}"
          BorderBrush="{DynamicResource AppBorder0}"
          BorderThickness="1">

    <DockPanel LastChildFill="True">

      <!-- Footer -->
      <Border DockPanel.Dock="Bottom"
              Padding="20,12"
              Background="{DynamicResource AppSurface1}"
              BorderBrush="{DynamicResource AppBorder0}"
              BorderThickness="0,1,0,0">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">

          <TextBlock Grid.Row="1" Grid.ColumnSpan="4"
                     Text="{Binding StatusMessage}"
                     FontSize="12"
                     Foreground="{DynamicResource AppForeground}"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap" />

          <Button Grid.Column="1" Classes="ghost"
                  Content="{Binding RestoreDefaultsButtonLabel}"
                  Command="{Binding RestoreDefaultsCommand}" />

          <Button Grid.Column="2" Classes="ghost"
                  Content="{Binding CancelButtonLabel}"
                  IsCancel="True"
                  Click="OnCancelClick"
                  Padding="18,9" />

          <Button Grid.Column="3" Classes="primary"
                  Content="{Binding ApplyButtonLabel}"
                  IsDefault="True"
                  Click="OnApplyClick"
                  Padding="22,9" />

        </Grid>
      </Border>


      <!--
          Scrollable form content.

          AllowAutoHide=False, and the bar is always VISIBLE rather than
          Auto, because this dialog reads as truncated otherwise. Its last
          section is the DSU / Cemuhook motion server, and the content is
          taller than the window: an auto-hidden bar gives no sign that
          anything is below the fold, and the obvious way to look — the
          mouse wheel — silently does nothing useful, because the pointer
          is usually over a ComboBox or a NumericUpDown, and those consume
          the wheel to change their own value. So the page appeared to end
          early and the motion-server settings appeared to be missing.

          The same AllowAutoHide reasoning is on the dashboard's scroller;
          this is the second place it mattered.
      -->
      <!--
          Padding lives on the CONTENT, not on the ScrollViewer.

          A ScrollViewer's own Padding insets the viewport, but the bottom
          inset is not added to the scrollable extent — so the last 20px of
          the form could never be scrolled into view and the final control
          sat permanently behind the footer button bar. Moving the same
          inset onto the StackPanel makes it part of the measured content,
          which the extent does account for, so the scroller now reaches
          the true bottom. The 8px spacer Border that used to sit at the
          end as a partial workaround is gone with it.
      -->
      <ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Visible"
                    AllowAutoHide="False">
        <StackPanel Spacing="20" Margin="24,20">

          <!-- Localization & Appearance section -->
          <StackPanel Spacing="10">
            <TextBlock Text="Localization &amp; Appearance"
                       Classes="sectionHeading" />
            <TextBlock Classes="hint" TextWrapping="Wrap" Text="Language and theme changes save immediately. Cancel does not undo them." />
            <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto" RowSpacing="8">
              <TextBlock Grid.Row="0" Grid.Column="0"
                         Text="{Binding Shell.LanguageLabel}"
                         FontSize="12" Foreground="{DynamicResource AppForeground}"
                         VerticalAlignment="Center" />
              <ComboBox Grid.Row="0" Grid.Column="1"
                        Width="240" HorizontalAlignment="Left"
                        ItemsSource="{Binding Shell.SupportedLanguages}"
                        SelectedItem="{Binding Shell.SelectedLanguage}" />
              <TextBlock Grid.Row="1" Grid.Column="0"
                         Text="{Binding Shell.ThemeLabel}"
                         FontSize="12" Foreground="{DynamicResource AppForeground}"
                         VerticalAlignment="Center" />
              <ComboBox Grid.Row="1" Grid.Column="1"
                        Width="240" HorizontalAlignment="Left"
                        ItemsSource="{Binding Shell.ThemeOptions}"
                        SelectedItem="{Binding Shell.SelectedTheme}" />
            </Grid>
          </StackPanel>

          <Border Classes="divider" />

          <!-- Diagnostics section -->
          <StackPanel Spacing="10">
            <TextBlock Text="{Binding DiagnosticsHeaderLabel}"
                       Classes="sectionHeading" />
            <Grid ColumnDefinitions="180,*" RowDefinitions="Auto" RowSpacing="6">
              <TextBlock Grid.Column="0" Text="{Binding LogLevelLabel}"
                         FontSize="12" Foreground="{DynamicResource AppForeground}"
                         VerticalAlignment="Center" />
              <ComboBox Grid.Column="1"
                        Width="200"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding AvailableLogLevels}"
                        SelectedItem="{Binding SelectedLogLevel, Mode=TwoWay}" />
            </Grid>
            <TextBlock Text="{Binding LogLevelHintLabel}"
                       Classes="hint" />
          </StackPanel>

          <Border Classes="divider" />

          <!-- Paths section -->
          <StackPanel Spacing="10">
            <TextBlock Text="{Binding WindowHeaderLabel}" Classes="sectionHeading" />
            <CheckBox Content="{Binding RememberWindowSizeLabel}" IsChecked="{Binding RememberWindowSize, Mode=TwoWay}" />
            <Grid ColumnDefinitions="180,Auto,Auto,Auto" ColumnSpacing="8" IsEnabled="{Binding RememberWindowSize}">
              <TextBlock Text="{Binding WindowWidthLabel}" VerticalAlignment="Center" />
              <NumericUpDown Grid.Column="1" Width="100" Minimum="200" Maximum="8000" Increment="50" Value="{Binding WindowWidth, Mode=TwoWay}" />
              <TextBlock Grid.Column="2" Text="{Binding WindowHeightLabel}" VerticalAlignment="Center" />
              <NumericUpDown Grid.Column="3" Width="100" Minimum="200" Maximum="8000" Increment="50" Value="{Binding WindowHeight, Mode=TwoWay}" />
            </Grid>
          </StackPanel>

          <Border Classes="divider" />

          <StackPanel Spacing="10">
            <TextBlock Text="{Binding PollingHeaderLabel}" Classes="sectionHeading" />
            <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto" RowSpacing="8">
              <TextBlock Text="{Binding DashboardRefreshLabel}" Foreground="{DynamicResource AppForeground}" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Width="160" HorizontalAlignment="Left" PlaceholderText="Automatic"
                       Text="{Binding DashboardRefreshHzText, Mode=TwoWay}" />
              <TextBlock Grid.Row="1" Text="{Binding PollingRateLabel}" Foreground="{DynamicResource AppForeground}" VerticalAlignment="Center" />
              <TextBox Grid.Row="1" Grid.Column="1" Width="160" HorizontalAlignment="Left" PlaceholderText="Use profile rate"
                       Text="{Binding PollingRateHzText, Mode=TwoWay}" />
            </Grid>
            <TextBlock Text="{Binding PollingHintLabel}" Classes="hint" TextWrapping="Wrap" />
          </StackPanel>

          <Border Classes="divider" />

          <StackPanel Spacing="10">
            <TextBlock Text="{Binding PathsHeaderLabel}"
                       Classes="sectionHeading" />

            <StackPanel Spacing="4">
              <TextBlock Text="{Binding ProfilesDirectoryLabel}"
                         FontSize="12" Foreground="{DynamicResource AppForeground}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox Grid.Column="0"
                         Text="{Binding ProfilesDirectoryOverride, Mode=TwoWay}"
                         PlaceholderText="{Binding CurrentProfilesPath}" />
                <Button Grid.Column="1" Classes="ghost"
                        Content="{Binding BrowseButtonLabel}"
                        Tag="profiles"
                        Click="OnBrowseClick"
                        Padding="14,8" />
              </Grid>
              <TextBlock Text="{Binding CurrentProfilesPath}"
                         FontSize="10.5" Foreground="{DynamicResource AppForegroundDim}"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Text="{Binding LogsDirectoryLabel}"
                         FontSize="12" Foreground="{DynamicResource AppForeground}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox Grid.Column="0"
                         Text="{Binding LogsDirectoryOverride, Mode=TwoWay}"
                         PlaceholderText="{Binding CurrentLogsPath}" />
                <Button Grid.Column="1" Classes="ghost"
                        Content="{Binding BrowseButtonLabel}"
                        Tag="logs"
                        Click="OnBrowseClick"
                        Padding="14,8" />
              </Grid>
              <TextBlock Text="{Binding CurrentLogsPath}"
                         FontSize="10.5" Foreground="{DynamicResource AppForegroundDim}"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding LogsPathHintLabel}"
                         Classes="hint" />
            </StackPanel>
          </StackPanel>

          <Border Classes="divider" />

          <!-- Startup section -->
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding StartupHeaderLabel}"
                       Classes="sectionHeading" />
            <CheckBox IsChecked="{Binding CheckForUpdatesOnStartup, Mode=TwoWay}"
                      Content="{Binding CheckUpdatesLabel}"
                      Foreground="{DynamicResource AppForeground}" />
            <CheckBox IsChecked="{Binding CheckRequirementsOnStartup, Mode=TwoWay}"
                      Content="{Binding CheckRequirementsLabel}"
                      Foreground="{DynamicResource AppForeground}" />
          </StackPanel>

          <Border Classes="divider" />

          <!-- Motion server (DSU / Cemuhook). A single global switch, not a
               per-controller one: the server streams whichever slots are
               enabled, and emulators address pads by DSU slot index, so
               there is nothing meaningful to turn on for one controller and
               off for another. Saves immediately rather than on Apply,
               matching the toggle's own behaviour. -->
          <StackPanel Spacing="6">
            <TextBlock Text="Motion server" Classes="sectionHeading" />
            <TextBlock Classes="hint" Text="These controls save immediately. Cancel only discards edits above. Local emulators should connect to 127.0.0.1." TextWrapping="Wrap" />
            <CheckBox IsChecked="{Binding MotionServer.AllowRemote, Mode=TwoWay}" Content="Allow emulators on other devices (trusted network only)" />
            <CheckBox IsChecked="{Binding MotionServer.IsEnabled, Mode=TwoWay}"
                      Content="Enable DSU / Cemuhook motion server"
                      Foreground="{DynamicResource AppForeground}" />
            <TextBlock Classes="hint" TextWrapping="Wrap"
                       Text="Streams gyroscope and accelerometer over UDP so Cemu, Dolphin, Yuzu and Ryujinx can use real motion." />
            <Grid ColumnDefinitions="180,Auto" VerticalAlignment="Center">
              <TextBlock Grid.Column="0" Text="UDP port"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource AppForeground}" />
              <TextBox Grid.Column="1" Width="100"
                       Text="{Binding MotionServer.Port, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
            </Grid>
            <TextBlock Classes="hint"
                       Text="Port must be between 1024 and 65535."
                       IsVisible="{Binding MotionServer.HasPortError}"
                       Foreground="{DynamicResource AppDanger}" />
            <TextBlock Classes="hint" TextWrapping="Wrap"
                       Text="{Binding MotionServer.Status}" />
          </StackPanel>

          <Border Classes="divider" />

          <!-- Per-app profile switching. The "in front now" line and the
               Use button exist because a rule matches an EXECUTABLE name,
               which nobody can guess from a game's title — without them
               the first rule anyone writes silently never fires. -->
          <StackPanel Spacing="6">
            <TextBlock Text="Per-app profiles" Classes="sectionHeading" />
            <CheckBox IsChecked="{Binding AppProfiles.IsEnabled, Mode=TwoWay}"
                      ToolTip.Tip="Application switching rules save immediately. Cancel does not undo them."
                      Content="Switch profile automatically when an app comes to the front"
                      Foreground="{DynamicResource AppForeground}" />
            <TextBlock Classes="hint" TextWrapping="Wrap"
                       Text="{Binding AppProfiles.Status}" />

            <ItemsControl ItemsSource="{Binding AppProfiles.Rules}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AppProfileRuleViewModel">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,2">
                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}" />
                    <TextBlock Grid.Column="1" Text="{Binding ProcessName}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppForeground}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding ProfileName}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppForegroundDim}"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="3" Classes="ghost" Content="Remove"
                            Command="{Binding $parent[ItemsControl].((vm:AppProfilePanelViewModel)DataContext).RemoveRuleCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnDefinitions="*,Auto,160,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0" PlaceholderText="Executable name"
                       Text="{Binding AppProfiles.NewProcessName, Mode=TwoWay}" />
              <Button Grid.Column="1" Classes="ghost" Content="Use current"
                      Command="{Binding AppProfiles.UseCurrentAppCommand}" />
              <ComboBox Grid.Column="2" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding AppProfiles.Profiles}"
                        SelectedItem="{Binding AppProfiles.NewProfile, Mode=TwoWay}"
                        DisplayMemberBinding="{Binding Label}" />
              <Button Grid.Column="3" Content="Add"
                      Command="{Binding AppProfiles.AddRuleCommand}" />
            </Grid>
            <TextBlock Classes="hint" TextWrapping="Wrap"
                       Text="Rules are checked top to bottom and the first match wins. An app with no rule leaves the current profile alone, so alt-tabbing to a browser mid-game changes nothing." />
          </StackPanel>

          <Border Classes="divider" />

          <!-- Setup walkthrough. Offered here because the first-run
               showing is once-only, and "how do I set this up again"
               has no other answer in the app. -->
          <StackPanel Spacing="6">
            <TextBlock Text="Setup" Classes="sectionHeading" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBlock Grid.Column="0" Classes="hint" VerticalAlignment="Center"
                         Text="Walks through connecting a controller and creating a virtual one, and sets it up for you." />
              <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Center"
                      Content="Run setup walkthrough"
                      Click="OnRunWalkthrough" />
            </Grid>
          </StackPanel>

          <Border Classes="divider" />

          <!-- Phone controller. The server starts with GameFlow; this section
               exposes the actual LAN address instead of making users find it
               in the log or infer it from the OBS URL. -->
          <StackPanel Spacing="6">
            <TextBlock Text="Phone controller" Classes="sectionHeading" />
            <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding Overlay.NetworkSharingButtonLabel}" Command="{Binding Overlay.ToggleNetworkSharingCommand}" HorizontalAlignment="Left" />
            <Button Classes="ghost" Content="Reset private link" Command="{Binding Overlay.ResetPrivateLinkCommand}"
                    ToolTip.Tip="Disconnects existing phones and invalidates old links. Copy the new link to reconnect." HorizontalAlignment="Left" />
            </StackPanel>
            <TextBlock Classes="hint" Text="{Binding Overlay.NetworkSharingStatus}" TextWrapping="Wrap" />
            <TextBlock Classes="hint" Text="Sharing is saved immediately. Keep this link private; use only trusted networks. OBS on this PC works with sharing off." TextWrapping="Wrap" />
            <TextBlock Classes="hint" TextWrapping="Wrap"
                       Text="Open this address on a phone connected to the same network. It will appear under Physical devices and can be assigned to a controller slot." />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0" IsReadOnly="True"
                       Text="{Binding Overlay.PhoneControllerUrl, Mode=OneWay}" />
              <Button Grid.Column="1" Classes="ghost" Content="Open"
                      ToolTip.Tip="Open the phone controller in this PC's browser, to check the server is reachable before trying a phone."
                      IsEnabled="{Binding Overlay.CanCopyPhoneControllerUrl}"
                      Click="OnOpenPhoneControllerUrl" />
              <Button Grid.Column="2" Content="Copy"
                      IsEnabled="{Binding Overlay.CanCopyPhoneControllerUrl}"
                      Click="OnCopyPhoneControllerUrl" />
            </Grid>
            <!--
                Reachability line. The address above can be perfectly
                correct and still time out on a phone, because Windows
                Firewall drops the inbound connection silently. Saying so
                here, next to the address, is the difference between a
                one-click fix and an unexplained failure.

                One button for every case: no rule, an old rule that does
                not match, or no URL reservation. An elevated GameFlow
                writes the rule by itself when the server starts, so this
                button is for a GameFlow that is not elevated.
            -->
            <Border Classes="inset" Padding="10,8"
                    IsVisible="{Binding Overlay.HasReachabilityWarning}"
                    Background="{DynamicResource AppWarningSoft}"
                    BorderBrush="{DynamicResource AppWarning}">
              <StackPanel Spacing="8">
                <TextBlock Classes="hint"
                           Foreground="{DynamicResource AppForeground}"
                           Text="{Binding Overlay.ReachabilityMessage}" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                  <Button Classes="ghost"
                          Content="Allow through firewall"
                          ToolTip.Tip="Adds an inbound rule for GameFlow on this port. It accepts devices on your local network only, never the internet. Windows will ask for administrator permission."
                          IsVisible="{Binding Overlay.CanAllowThroughFirewall}"
                          Command="{Binding Overlay.AllowThroughFirewallCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <TextBlock Classes="hint" TextWrapping="Wrap"
                       Text="The browser reconnects automatically and keeps the same pad number. Rumble returns through the phone's Vibration API when the browser supports it." />
          </StackPanel>

          <Border Classes="divider" />

          <!-- Stream overlay. Builds a URL rather than showing a preview:
               the browser source is what renders it, and the app has no
               way to know how OBS will size or crop the result. Nothing
               here is saved — see OverlayPanelViewModel. -->
          <StackPanel Spacing="6">
            <TextBlock Text="Stream overlay" Classes="sectionHeading" />
            <TextBlock Classes="hint" TextWrapping="Wrap"
                       Text="Add a Browser source in OBS and paste this URL. The background is transparent, so it composites straight over your scene." />

            <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto" RowSpacing="6">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Controller"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource AppForeground}" />
              <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Overlay.Slots}"
                        SelectedItem="{Binding Overlay.SelectedSlot, Mode=TwoWay}"
                        DisplayMemberBinding="{Binding Label}" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Skin"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource AppForeground}" />
              <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Overlay.Themes}"
                        SelectedItem="{Binding Overlay.SelectedTheme, Mode=TwoWay}"
                        DisplayMemberBinding="{Binding Label}" />
            </Grid>

            <CheckBox IsChecked="{Binding Overlay.ShowPhysical, Mode=TwoWay}"
                      Content="Show the physical pad instead of the virtual output"
                      Foreground="{DynamicResource AppForeground}" />

            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0" IsReadOnly="True"
                       Text="{Binding Overlay.Url, Mode=OneWay}" />
              <Button Grid.Column="1" Classes="ghost" Content="Preview"
                      ToolTip.Tip="Open the overlay in a browser so you can see what OBS will render before adding the source."
                      IsEnabled="{Binding Overlay.CanCopy}"
                      Click="OnOpenOverlayUrl" />
              <Button Grid.Column="2" Content="Copy"
                      IsEnabled="{Binding Overlay.CanCopy}"
                      Click="OnCopyOverlayUrl" />
            </Grid>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>


    </DockPanel>
  </Border>
</Window>
