<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GameFlow.App.Views.UpdateAvailableDialog"
        Width="600"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppSurface0}"
        Title="{DynamicResource Ui.UiUpdateAvailable}">

  <Border Margin="0"
          ClipToBounds="True"
          Background="{DynamicResource AppSurface1}"
          BorderBrush="{DynamicResource AppBorder0}"
          BorderThickness="1">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="24,20,24,20" RowSpacing="14">

      <!-- Header -->
      <StackPanel Grid.Row="0" Spacing="6">
        <TextBlock Text="{DynamicResource Ui.UiANewVersionOfGameFlowIsAvailable}"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="{DynamicResource AppForeground}" />
        <TextBlock Name="VersionLine"
                   FontSize="12.5"
                   Foreground="{DynamicResource AppForegroundDim}"
                   TextWrapping="Wrap" />
      </StackPanel>

      <!-- Release name (often the tag, sometimes a friendly title) -->
      <Border Grid.Row="1"
              Classes="card"
              Padding="14,12"
              CornerRadius="10">
        <StackPanel Spacing="8"><TextBlock Name="ReleaseName"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource AppAccentHover}"
                   TextWrapping="Wrap" />
          <TextBlock Name="DownloadHint" TextWrapping="Wrap" Classes="hint"
                     Text="{DynamicResource Ui.UiDownloadsAVerifiedArchiveYouWillExtractItAnd}" />
        </StackPanel>
      </Border>

      <!-- Release notes link -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
        <TextBlock Text="{DynamicResource Ui.UiReadTheReleaseNotes}"
                   FontSize="12"
                   Foreground="{DynamicResource AppForegroundDim}"
                   VerticalAlignment="Center" />
        <Button Classes="link"
                Click="OnReleaseNotesClick"
                VerticalAlignment="Center">
          <TextBlock Name="ReleaseNotesLinkText"
                     Text="{DynamicResource Ui.UiOpenInBrowser}"
                     FontSize="12"
                     Foreground="{DynamicResource AppAccentHover}"
                     TextDecorations="Underline"
                     TextTrimming="CharacterEllipsis"
                     MaxWidth="330" />
        </Button>
      </StackPanel>

      <!-- Optional progress bar shown during download -->
      <StackPanel Grid.Row="3"
                  Name="ProgressArea"
                  IsVisible="False"
                  Spacing="6">
        <TextBlock Name="ProgressLine"
                   TextWrapping="Wrap"
                   FontSize="11.5"
                   Foreground="{DynamicResource AppForegroundDim}" />
        <ProgressBar Name="DownloadProgress"
                     Minimum="0"
                     Maximum="1"
                     Height="6" />
      </StackPanel>

      <!-- Footer buttons -->
      <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
        <Button Grid.Column="0"
                Name="SkipButton"
                Classes="ghost"
                Content="{DynamicResource Ui.UiSkipThisUpdate}"
                Click="OnSkipClick"
                Padding="14,9" />

        <Button Grid.Column="1"
                Name="DontAskButton"
                Classes="ghost"
                Content="{DynamicResource Ui.UiDonTAskAgain}"
                Click="OnDontAskClick"
                Padding="14,9" />

        <StackPanel Grid.Column="3" Spacing="6">
        <Button Name="CancelDownloadButton" IsVisible="False" Content="{DynamicResource Ui.UiCancelDownload}" Click="OnCancelDownloadClick" />
        <Button
                Name="InstallButton"
                Classes="primary"
                Content="{DynamicResource Ui.UiDownloadUpdate}"
                IsDefault="True"
                Click="OnInstallClick"
                Padding="16,9" />
        </StackPanel>
      </Grid>

    </Grid>
  </Border>
</Window>
