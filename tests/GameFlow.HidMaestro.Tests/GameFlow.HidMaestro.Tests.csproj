<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\build\HidMaestroSdk.props" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GameFlow.HidMaestro\GameFlow.HidMaestro.csproj" />
    <ProjectReference Include="..\..\src\GameFlow.Infrastructure\GameFlow.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Moq" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copied to the output: the tests load the SDK at runtime. -->
    <Reference Include="HIDMaestro.Core"><HintPath>$(HidMaestroSdkDll)</HintPath><Private>true</Private></Reference>
  </ItemGroup>

  <Import Project="..\..\build\HidMaestroSdk.targets" />
</Project>
